# Copy to .env (docker compose reads it). On Dokploy, put these in the Environment tab instead.

# The address your team uses (HTTPS). Goes into invite links.
DIALCATZ_PUBLIC_URL=https://dialcatz.example.com

# Empty = SQLite in the data volume. Or postgres://user:pass@host:5432/dialcatz
DATABASE_URL=

# Only for docker-compose.postgres.yml
POSTGRES_PASSWORD=

# Optional; generated into the data volume when empty.
DIALCATZ_SECRET_KEY=

# Optional admin sign-in with your own OAuth apps (redirect URL: <public url>/api/admin/oauth/<google|github>/callback)
DIALCATZ_GOOGLE_CLIENT_ID=
DIALCATZ_GOOGLE_CLIENT_SECRET=
DIALCATZ_GITHUB_CLIENT_ID=
DIALCATZ_GITHUB_CLIENT_SECRET=

# Only with docker-compose.local.yml
DIALCATZ_PORT=8080
